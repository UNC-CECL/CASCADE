# Ignored wholesale EXCEPT output/raw_runs/, whose small text products are
# tracked -- see the CASCADE run outputs block at the bottom of this file.
output/*
!output/raw_runs/

# joint_fit.json is the ONLY thing under output/ that is an INPUT rather than a
# product: HAT_run_all.py stage 6 reads it and passes its (M, f) to every groin
# run in the matrix. Untracked, the calibrated pair lived on one machine only --
# a clone had no groin parameters at all, and the values existed solely in
# commit messages. Tracked, the pin travels with the repository.
# The directory is re-included and then re-excluded so ONLY this file returns;
# the sweep cells and figures beside it stay ignored.
!output/groin_sweep/
output/groin_sweep/*
!output/groin_sweep/joint_fit.json

# coastsat_smoothed_table.csv was tracked while it sat beside its script under
# scripts/analyze_output/. Moving the products into output/comparisons/ on
# 2026-09-02 would have dropped it from version control silently, so it is
# re-included by the same directory-in, contents-out pattern as joint_fit.json.
# It is the LOESS-smoothed CoastSat table the smoothing comparison reports on;
# the PNGs beside it stay ignored, being regenerable from it plus the code.
!output/comparisons/
output/comparisons/*
!output/comparisons/smoothing_vs_cascade/
output/comparisons/smoothing_vs_cascade/*
!output/comparisons/smoothing_vs_cascade/1984_2004/
output/comparisons/smoothing_vs_cascade/1984_2004/*
!output/comparisons/smoothing_vs_cascade/1984_2004/coastsat_smoothed_table.csv

